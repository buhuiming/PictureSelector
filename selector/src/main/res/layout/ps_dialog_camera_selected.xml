<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_rounded">

    <TextView
        android:id="@+id/ps_tv_photo"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/ps_item_select_bg"
        android:gravity="center"
        android:text="@string/ps_photograph"
        android:textColor="@color/ps_color_53575e"
        android:textSize="17sp" />

    <View
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@id/ps_tv_photo"
        android:background="@color/ps_color_e" />

    <TextView
        android:id="@+id/ps_tv_video"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_below="@id/top_line"
        android:background="@drawable/ps_item_select_bg"
        android:gravity="center"
        android:text="@string/ps_record_video"
        android:textColor="@color/ps_color_53575e"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_below="@id/ps_tv_video"
        android:background="#F9F9F9" />

    <TextView
        android:id="@+id/ps_tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="15dp"
        android:layout_below="@id/bottom_line"
        android:background="@drawable/ps_item_select_bg"
        android:gravity="center"
        android:text="@string/ps_cancel"
        android:textColor="@color/ps_color_53575e"
        android:textSize="16sp" />
</RelativeLayout>